# Copy this file to .env for local development. Never commit .env or share API secrets.
NODE_ENV=development
PORT=3000
PUBLIC_SITE_URL=http://localhost:3000
DATABASE_PATH=./data/orders.sqlite

# Stripe Dashboard -> Developers -> API keys. Use test keys until the shop is ready.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal Developer Dashboard -> Apps & Credentials. Keep sandbox mode until launch.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Resend -> API Keys. Verify the sending domain before using a live sender address.
RESEND_API_KEY=
EMAIL_FROM=
ORDER_EMAIL_TO=inezanthony@yahoo.com.au
